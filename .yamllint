---
extends: default

ignore: |
  .terraform/

rules:
  line-length: disable
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  truthy:
    check-keys: false # allow GitHub Actions' bare `on:` key
